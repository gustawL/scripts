print_menu(){
    # menu options counter
    menu_opt_num=8;

    echo '';
    color_selection green '      System updater';
    echo;
    echo '    ------------------';

    color_selection green '1';
    color_selection blue ') ';
    echo ' Sync repo';

    color_selection green '2';
    color_selection blue ') ';
    echo ' Check and update';

    color_selection green '3';
    color_selection blue ') ';
    echo ' Run depclean';

    color_selection green '4';
    color_selection blue ') ';
    echo ' Run dispatch-conf';

    color_selection green '5';
    color_selection blue ') ';
    echo ' Update man pages';

    color_selection green '6';
    color_selection blue ') ';
    echo ' Update portage';

    color_selection green '7';
    color_selection blue ') ';
    echo ' New use';

    color_selection green '8';
    color_selection blue ') ';
    echo ' Read news and exit';

    echo '    ------------------';

    color_selection green 'q';
    color_selection blue ') ';
    echo ' Quit program';

    color_selection green 'r';
    color_selection blue ') ';
    echo ' Reboot system';

    color_selection green 'p';
    color_selection blue ') ';
    echo ' Poweroff system';

    # End, do not delete last echo!
    echo;
}
