help_fn(){
    echo '';
    color_selection green '         System updater';
    echo;
    echo '    ------------------------';
    color_selection green '    Author: Gustaw Lizak';
    echo;
    color_selection cyan '    https://gustawl.github.io';
    echo;
    echo '    ------------------------';

    echo -n '    '
    color_selection blue "[";
		echo -n " ";
		color_selection green "-u";
		echo -n " ";
		color_selection blue "]";
		echo -n " Run updater. ";
		echo;

    echo -n '    '
    color_selection blue "[";
		echo -n " ";
		color_selection green "-h";
		echo -n " ";
		color_selection blue "]";
		echo -n " Shows this help. ";
		echo;

    exit 0;
}
