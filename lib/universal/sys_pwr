# Reference in case of wonder
# https://madaidans-insecurities.github.io/guides/linux-hardening.html#machine-id

reboot_pc(){
    [[ -e /etc/machine-id ]] && { sudo rm -f /etc/machine-id; };
    [[ -e /var/lib/dbus/machine-id ]] && { sudo rm -f /var/lib/dbus/machine-id; };
    sudo reboot;
}

poweroff_pc(){
    [[ -e /etc/machine-id ]] && { sudo rm -f /etc/machine-id; };
    [[ -e /var/lib/dbus/machine-id ]] && { sudo rm -f /var/lib/dbus/machine-id; };
    sudo poweroff;
}
